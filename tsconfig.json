{
  "//": "TypeScript Fase 1 — infraestructura de verificación de tipos, NO de build. Ver docs/TYPESCRIPT_MIGRATION.md para el detalle completo de cada decisión.",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "CONTROL_ENGRASE_WEB/CONTROL_ENGRASE_WEB/src/**/*.ts",
    "CONTROL_ENGRASE_WEB/CONTROL_ENGRASE_WEB/src/**/*.js"
  ],
  "exclude": ["node_modules", "dist", "CONTROL_ENGRASE_APP_ANDROID"]
}
