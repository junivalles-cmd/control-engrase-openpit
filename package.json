{
  "name": "control-engrase-tests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Herramientas de desarrollo del repositorio (pruebas automatizadas, build Vite). No es la app en sí — ver CONTROL_ENGRASE_WEB y CONTROL_ENGRASE_APP_ANDROID.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:dist": "node tools/verify-dist.mjs",
    "build:web": "npm test && npm run build && npm run verify:dist",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "test:ui:screenshots": "playwright test --update-snapshots",
    "lint:css": "stylelint \"CONTROL_ENGRASE_WEB/CONTROL_ENGRASE_WEB/styles.css\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
